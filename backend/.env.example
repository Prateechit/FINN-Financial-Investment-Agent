# Copy to backend/.env and fill in. Never commit the real file.

# Postgres in production (Neon / Render / Supabase). Omit locally to use SQLite (backend/finn.db).
DATABASE_URL=

# Free-tier LLMs — any one is enough; both gives routing + fallback.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey  (long documents, reasoning)
GROQ_API_KEY=          # https://console.groq.com/keys       (fast, short tasks)
# OPENROUTER_API_KEY=  # optional extra fallback
# FINN_USE_OLLAMA=1    # local fallback (http://localhost:11434)

# Protects POST /api/ingest
FINN_INGEST_TOKEN=change-me
FINN_CORS_ORIGINS=*
